  "findings": [
    {
      "source": "DeepMimic ImpPDController",
      "finding": "Implicit damping and joint-relative target pose/velocity; imitation needs a trained policy and a matching physical humanoid."
    },
    {
      "source": "orangeduck Motion-Matching",
      "finding": "Pose/velocity and future trajectory choose candidates; inertialization preserves transition continuity. A number of additive profiles is not a number of captured motions."
    },
    {
      "source": "Jolt Ragdoll",
      "finding": "Connected bodies, limited joints and stable motor targets are separate from motion selection."
    },
    {
      "source": "MimicKit",
      "finding": "Motion imitation requires simulated training environments, reference motion, and separate policy evaluation. Public sample policies are not calibrated for this game skeleton."
    }
  ],
  "implementation_scope": "Native contacts and trajectories remain authoritative; reduced learned balance planner and relative joint muscles, not Euphoria or a trained football whole-body RL policy."
